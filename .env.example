# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_STORE_CURRENCY: Default currency (SAR, AED, USD, EUR, GBP)
VITE_STORE_CURRENCY="SAR"

# Optional Payment Gateway Public Keys (Client-side safe keys only)
# VITE_STRIPE_PUBLISHABLE_KEY="pk_test_sample"
# VITE_MOYASAR_PUBLISHABLE_KEY="pk_test_sample"

# Optional Newsletter Provider
# VITE_KLAVIYO_PUBLIC_KEY="sample_key"
